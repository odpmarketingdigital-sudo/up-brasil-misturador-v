# Número do WhatsApp da UP Brasil (com DDI, sem espaços ou símbolos).
# Exemplo: 5511999998888
NEXT_PUBLIC_WHATSAPP_NUMBER=55DDDNUMERO

# URL do Google Apps Script publicado como Web App (doPost).
# Veja /docs/google-sheets.md para criar e publicar. Nunca use NEXT_PUBLIC_.
GOOGLE_SHEETS_WEBHOOK_URL=

# URL canônica do site (usada em metadata, sitemap, robots e JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
